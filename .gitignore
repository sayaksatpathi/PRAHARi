__pycache__/
*.py[cod]
.venv/
venv/
var/
models/*.onnx
*.db
*.db-wal
*.db-shm
.env
.pytest_cache/
*.mp4
*.avi
footage/
vendor/
models/*.onnx
models/manifest.json    # generated per-deployment by scripts/generate_model_manifest.py

# MediaMTX writes self-signed certs into its working directory
auto.crt
auto.key

# Datasets and run logs fetched/produced locally; never committed.

*.log


# Datasets are fetched, never committed (scripts/fetch_*.py reproduce them).
datasets/

# Large dataset payloads live under data/ but are never committed. Only the
# folder READMEs, provenance and provision scripts are tracked; the imagery,
# video, weights and archives are reproduced via scripts/provision_datasets.ps1.
data/training/**
data/testing/**
data/demo/**
!data/**/README.md
!data/**/.gitkeep
# Track the tiny border-scenario ground-truth JSONs (deliverables); the rendered
# .mp4 clips stay ignored via the *.mp4 rule below.
!data/demo/border_scenarios/
!data/demo/border_scenarios/*.json
*.zip
*.onnx
*.pt
*.pth
*.tar
*.tar.gz

# Binary presentation deliverables (regenerated; delivered out-of-band, not committed)
*.pptx
*.pdf

# Awiros Indian ANPR model weights + auto-cloned PaddleOCR (large; not committed)
*.safetensors
models/awiros_anpr/PaddleOCR/
models/awiros_anpr/crops/
