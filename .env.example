# ============================================================
# PRAHARI - example environment. Copy to .env and edit.
# NEVER commit .env. Camera credentials live here, not in code.
# ============================================================

PRAHARI_NODE_ID=BOP-EDGE-01
PRAHARI_NODE_NAME=Border Outpost Edge Node 01
PRAHARI_SECTOR=SECTOR-NORTH

# --- Server ---
PRAHARI_HOST=127.0.0.1
PRAHARI_PORT=8420

# --- Storage (edge is SQLite + local disk by design; see docs/architecture.md) ---
PRAHARI_DATA_DIR=./var
PRAHARI_DB_PATH=./var/prahari-edge.db
PRAHARI_EVIDENCE_DIR=./var/evidence

# --- Inference ---
PRAHARI_DETECTOR=auto                 # auto | onnx | synthetic
PRAHARI_MODEL_PATH=./models/yolo.onnx
PRAHARI_DEVICE=auto                   # auto | cpu | cuda
PRAHARI_INFERENCE_INTERVAL=2          # run the detector every Nth frame
PRAHARI_DETECTION_CONFIDENCE=0.35
PRAHARI_NMS_IOU=0.45

# --- Tracking ---
PRAHARI_TRACK_TIMEOUT_SECONDS=5
PRAHARI_TRACK_MATCH_IOU=0.30

# --- Event rules (all configurable; nothing operational is hard-coded) ---
PRAHARI_LOITERING_THRESHOLD_SECONDS=30
PRAHARI_INTRUSION_CONFIDENCE=0.50
PRAHARI_GROUP_SIZE_THRESHOLD=3
PRAHARI_GROUP_WINDOW_SECONDS=20
PRAHARI_EVENT_COOLDOWN_SECONDS=30

# --- Evidence ---
PRAHARI_EVENT_CLIP_BEFORE_SECONDS=3
PRAHARI_EVENT_CLIP_AFTER_SECONDS=7
PRAHARI_EVIDENCE_RETENTION_DAYS=30

# --- Offline store-and-forward ---
PRAHARI_CORE_URL=http://127.0.0.1:9420
PRAHARI_SYNC_ENABLED=true
PRAHARI_SYNC_RETRY_SECONDS=10
PRAHARI_SYNC_BATCH_SIZE=25
PRAHARI_QUEUE_MAX_BYTES=2147483648    # 2 GiB before eviction policy kicks in

# --- Alert budget (operator trust; see docs/alerting.md) ---
PRAHARI_ALERT_BUDGET_PER_HOUR=20

# --- Auth ---
PRAHARI_SECRET_KEY=change-me-to-a-long-random-string
PRAHARI_TOKEN_TTL_SECONDS=28800
